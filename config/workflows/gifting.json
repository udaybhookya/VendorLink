{
  "id": "gifting",
  "version": 1,
  "workflows": [
    {"job_type": "onboard_vendor", "steps": [{"capability": "vendor.verify"}, {"capability": "compliance.check", "optional": true}]},
    {"job_type": "build_listing", "steps": [
      {"capability": "catalogue.build"},
      {"capability": "grade.*"},
      {"capability": "image.assess", "optional": true},
      {"capability": "image.enhance", "optional": true},
      {"capability": "listing.enrich", "optional": true}
    ]},
    {"job_type": "propose_terms", "steps": [{"capability": "terms.propose"}]},
    {"job_type": "place_order", "steps": [{"capability": "order.create"}]}
  ]
}
