      "email": "${FRESHCART_CATEGORY_EMAIL:-category@freshcart.example}"
    },
    {
      "role": "ops",
      "name": "Operations",
      "slack": "${FRESHCART_OPS_SLACK:-#freshcart-ops}",
      "email": "${FRESHCART_OPS_EMAIL:-ops@freshcart.example}"
    }
  ]
}
