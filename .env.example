# Copy to .env (never commit .env). Defaults run everything locally with no cloud.
# Where to get each key and how to run everything locally: docs/LOCAL_SETUP.md

# Backends: local fallbacks by default (CLAUDE.md rule 8)
VL_STORE=sqlite            # memory (tests) | sqlite (local, survives restarts) | firestore
VL_BLOB=local              # local | gcs
VL_SIGNER=local            # local | kms
VL_SCREEN=heuristic        # heuristic | model_armor

# Local data directory for LocalBlobStore and LocalSigner keys
VL_DATA_DIR=.vl_data

# Config root (versioned JSON configs)
VL_CONFIG_DIR=config

# Seeding: which preset in config/presets/ to activate (A or B)
ACTIVE_CONFIG=A

# Models (never hardcode model names in code)
LIVE_MODEL=
PRO_MODEL=
FLASH_MODEL=
IMAGE_MODEL=                # optional, e.g. gemini-3.1-flash-image: AI product photos; empty = auto-enhanced + retake tips

# GCP (only needed when a backend flag above is set to a cloud value)
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=
GCS_BUCKET=
KMS_KEYRING=                # ring id, or projects/P/locations/L/keyRings/R
MODEL_ARMOR_TEMPLATE=       # template id, or its full name (VL_SCREEN=model_armor)

# Service URLs (local ports)
VENDOR_SVC_URL=http://localhost:8001
RETAILER_SVC_URL=http://localhost:8002
TRUST_GATEWAY_URL=http://localhost:8000
MOCKS_URL=http://localhost:8009

# Bootstrap token for registering agent credentials at the gateway (local dev only)
VL_ADMIN_TOKEN=local-dev-only-change-me
# /dev/* endpoints (reset, seed, tamper demo). Must be false in any deployment.
VL_DEV_ENDPOINTS=true
# Hosted demo only: /dev/reset|tick|tamper answer the admin token (tamper also the operator
# token); the outbox stays closed. Set by infra/deploy.sh (ADR 0014).
VL_DEMO_ENDPOINTS=false
TOKEN_TTL_SECONDS=300
VL_RATE_LIMIT_PER_MINUTE=120     # gateway default per agent (control API can override one)
# Operator token for the control API (suspend/quarantine/revoke/freeze). Local dev only.
VL_OPERATOR_TOKEN=local-operator-change-me
# Tracing export: off | console | cloud (Cloud Trace). Trace ids are produced either way.
VL_TRACE=off

# ---- Models (Google ADK / Gemini). Model names: LIVE_MODEL, PRO_MODEL, FLASH_MODEL above.
# Either an API key (local) …
GOOGLE_API_KEY=
# … or Vertex AI (deploy): GOOGLE_GENAI_USE_VERTEXAI=true + GOOGLE_CLOUD_PROJECT/LOCATION.
# This one flag decides for both the JSON calls and the Concierge (ADK).
GOOGLE_GENAI_USE_VERTEXAI=false

# ---- Human in the loop
# local = Slack/Gmail messages go to the dev outbox (/dev/outbox, console "Outbox (dev)")
# mcp   = sent through the MCP servers configured below
VL_CHANNELS=local
VL_HITL_TICK_SECONDS=15          # Liaison pass: poll replies, remind, escalate, expire (0 = off)
VL_PUBLIC_URL=http://localhost:5173
VL_CORS_ORIGINS=*                # deploy: the hosted web app's origin only

# Slack MCP server (stdio command or HTTP URL). Secrets are passed by NAME only.
# Step-by-step: docs/LOCAL_SETUP.md. Local example: COMMAND=npx, ARGS='["-y", "@zencoderai/slack-mcp-server"]'
MCP_SLACK_TRANSPORT=stdio
MCP_SLACK_COMMAND=
MCP_SLACK_ARGS=
MCP_SLACK_URL=
MCP_SLACK_HEADERS=
MCP_SLACK_ENV_PASSTHROUGH=SLACK_BOT_TOKEN,SLACK_TEAM_ID
SLACK_BOT_TOKEN=
SLACK_TEAM_ID=

# Gmail MCP server. Local example: COMMAND=npx, ARGS='["-y", "@gongrzhe/server-gmail-autoauth-mcp"]'
# (that server sends and nudges; it does not return reply bodies, so answers come via Slack/app)
MCP_GMAIL_TRANSPORT=stdio
MCP_GMAIL_COMMAND=
MCP_GMAIL_ARGS=
MCP_GMAIL_URL=
MCP_GMAIL_HEADERS=
MCP_GMAIL_ENV_PASSTHROUGH=GMAIL_OAUTH_PATH,GMAIL_CREDENTIALS_PATH
GMAIL_OAUTH_PATH=
GMAIL_CREDENTIALS_PATH=

# Who is asked at the demo retailer (config/contacts/retailer_freshcart.json reads these)
FRESHCART_BUYER_SLACK=
FRESHCART_BUYER_EMAIL=
FRESHCART_CATEGORY_SLACK=
FRESHCART_CATEGORY_EMAIL=
FRESHCART_CATEGORY_LEAD_SLACK=     # counter approvals the buyer leaves unanswered
FRESHCART_CATEGORY_LEAD_EMAIL=
FRESHCART_OPS_SLACK=
FRESHCART_OPS_EMAIL=

# Durable job state (LangGraph): memory | sqlite (local) | postgres (deploy, Cloud SQL)
VL_CHECKPOINTS=sqlite
VL_CHECKPOINT_DSN=

# Logs: one line per event. INFO = what happened (orders, decisions, agent and model calls,
# questions to people); DEBUG adds routine reads and calls between services.
# How long a relay between vendor and retailer waits; their agents may make several model calls.
VL_RELAY_TIMEOUT_SECONDS=120
LOG_LEVEL=INFO
VL_LOG_FORMAT=auto          # auto (pretty on a terminal, JSON otherwise) | pretty | json
