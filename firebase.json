{
  "hosting": {
    "public": "web/dist",
    "ignore": [
      "firebase.json",
      "**/.*"
    ],
    "rewrites": [
      {
        "source": "/vendor",
        "destination": "/vendor/index.html"
      },
      {
        "source": "/vendor/**",
        "destination": "/vendor/index.html"
      },
      {
        "source": "/retailer",
        "destination": "/retailer/index.html"
      },
      {
        "source": "/retailer/**",
        "destination": "/retailer/index.html"
      }
    ],
    "headers": [
      {
        "source": "/assets/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          }
        ]
      },
      {
        "source": "**",
        "headers": [
          {
            "key": "X-Content-Type-Options",
            "value": "nosniff"
          },
          {
            "key": "Referrer-Policy",
            "value": "strict-origin-when-cross-origin"
          },
          {
            "key": "Permissions-Policy",
            "value": "microphone=(self), camera=(self)"
          }
        ]
      }
    ]
  }
}
