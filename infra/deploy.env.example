# Copy to infra/deploy.env (never committed). Read by infra/deploy.sh and infra/deploy_web.sh.

# The web app's Firebase Hosting site (https://<site>.web.app). Empty: the project's own site.
# Create one once: firebase hosting:sites:create <site> --project $GOOGLE_CLOUD_PROJECT
FIREBASE_SITE=

# deploy.sh passes these to retailer-svc:
# who the Liaison asks at the demo retailer (config/contacts/retailer_freshcart.json).
# Slack: a channel id (C…) or user id (U…); invite the VendorLink bot to each channel.
FRESHCART_BUYER_SLACK=
FRESHCART_BUYER_EMAIL=
FRESHCART_CATEGORY_SLACK=
FRESHCART_CATEGORY_EMAIL=
FRESHCART_CATEGORY_LEAD_SLACK=
FRESHCART_CATEGORY_LEAD_EMAIL=
FRESHCART_OPS_SLACK=
FRESHCART_OPS_EMAIL=
