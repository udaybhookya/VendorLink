{
  "$defs": {
    "ActiveConfig": {
      "additionalProperties": false,
      "properties": {
        "retailer_id": {
          "title": "Retailer Id",
          "type": "string"
        },
        "refs": {
          "$ref": "#/$defs/ConfigRefs",
          "description": "Pinned to concrete versions"
        },
        "business_profile": {
          "$ref": "#/$defs/BusinessProfile"
        },
        "retailer_profile": {
          "$ref": "#/$defs/RetailerProfile"
        },
        "country_pack": {
          "$ref": "#/$defs/CountryPack"
        },
        "retailer_policy": {
          "$ref": "#/$defs/RetailerPolicy"
        },
        "workflows": {
          "$ref": "#/$defs/WorkflowSet"
        },
        "specialists": {
          "items": {
            "type": "string"
          },
          "title": "Specialists",
          "type": "array"
        },
        "config_hash": {
          "title": "Config Hash",
          "type": "string"
        },
        "activated_at": {
          "format": "date-time",
          "title": "Activated At",
          "type": "string"
        }
      },
      "required": [
        "retailer_id",
        "refs",
        "business_profile",
        "retailer_profile",
        "country_pack",
        "retailer_policy",
        "workflows",
        "specialists",
        "config_hash",
        "activated_at"
      ],
      "title": "ActiveConfig",
      "type": "object"
    },
    "AttributeSpec": {
      "additionalProperties": false,
      "properties": {
        "key": {
          "title": "Key",
          "type": "string"
        },
        "label": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Label",
          "type": "object"
        },
        "type": {
          "enum": [
            "str",
            "int",
            "decimal",
            "bool",
            "enum"
          ],
          "title": "Type",
          "type": "string"
        },
        "required": {
          "default": false,
          "title": "Required",
          "type": "boolean"
        },
        "options": {
          "items": {
            "type": "string"
          },
          "title": "Options",
          "type": "array"
        }
      },
      "required": [
        "key",
        "label",
        "type"
      ],
      "title": "AttributeSpec",
      "type": "object"
    },
    "BusinessProfile": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "version": {
          "minimum": 1,
          "title": "Version",
          "type": "integer"
        },
        "name": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Name",
          "type": "object"
        },
        "attributes": {
          "items": {
            "$ref": "#/$defs/AttributeSpec"
          },
          "title": "Attributes",
          "type": "array"
        },
        "units": {
          "items": {
            "type": "string"
          },
          "title": "Units",
          "type": "array"
        },
        "grading_rules": {
          "$ref": "#/$defs/GradingRules"
        },
        "required_docs": {
          "description": "DocSpec roles; the Country Pack names the documents",
          "items": {
            "type": "string"
          },
          "title": "Required Docs",
          "type": "array"
        },
        "specialists": {
          "description": "Agent ids to load",
          "items": {
            "type": "string"
          },
          "title": "Specialists",
          "type": "array"
        }
      },
      "required": [
        "id",
        "version",
        "name",
        "units"
      ],
      "title": "BusinessProfile",
      "type": "object"
    },
    "Category": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "name": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Name",
          "type": "object"
        },
        "units": {
          "items": {
            "type": "string"
          },
          "title": "Units",
          "type": "array"
        }
      },
      "required": [
        "id",
        "name"
      ],
      "title": "Category",
      "type": "object"
    },
    "ConfigRef": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "version": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "None = latest",
          "title": "Version"
        }
      },
      "required": [
        "id"
      ],
      "title": "ConfigRef",
      "type": "object"
    },
    "ConfigRefs": {
      "additionalProperties": false,
      "properties": {
        "business_profile": {
          "$ref": "#/$defs/ConfigRef"
        },
        "retailer_profile": {
          "$ref": "#/$defs/ConfigRef"
        },
        "country_pack": {
          "$ref": "#/$defs/ConfigRef"
        },
        "retailer_policy": {
          "$ref": "#/$defs/ConfigRef"
        },
        "workflows": {
          "anyOf": [
            {
              "$ref": "#/$defs/ConfigRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "None = profile's set"
        }
      },
      "required": [
        "business_profile",
        "retailer_profile",
        "country_pack",
        "retailer_policy"
      ],
      "title": "ConfigRefs",
      "type": "object"
    },
    "CountryPack": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "pattern": "^[A-Z]{2}$",
          "title": "Code",
          "type": "string"
        },
        "version": {
          "minimum": 1,
          "title": "Version",
          "type": "integer"
        },
        "name": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Name",
          "type": "object"
        },
        "languages": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Languages",
          "type": "array"
        },
        "default_language": {
          "title": "Default Language",
          "type": "string"
        },
        "currency": {
          "pattern": "^[A-Z]{3}$",
          "title": "Currency",
          "type": "string"
        },
        "timezone": {
          "title": "Timezone",
          "type": "string"
        },
        "local_units": {
          "items": {
            "type": "string"
          },
          "title": "Local Units",
          "type": "array"
        },
        "id_docs": {
          "items": {
            "$ref": "#/$defs/DocSpec"
          },
          "title": "Id Docs",
          "type": "array"
        },
        "food_safety_regs": {
          "items": {
            "$ref": "#/$defs/DocSpec"
          },
          "title": "Food Safety Regs",
          "type": "array"
        },
        "consent_wording": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Consent Wording",
          "type": "object"
        },
        "label_keywords": {
          "additionalProperties": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "description": "Label field → words that introduce it on a label; `halal` → halal marks",
          "title": "Label Keywords",
          "type": "object"
        }
      },
      "required": [
        "code",
        "version",
        "name",
        "languages",
        "default_language",
        "currency",
        "timezone"
      ],
      "title": "CountryPack",
      "type": "object"
    },
    "DocSpec": {
      "additionalProperties": false,
      "description": "An identity document or food-safety registration, with its number format.",
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "role": {
          "description": "Generic role a Business Profile requires, e.g. 'identity'",
          "title": "Role",
          "type": "string"
        },
        "name": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Name",
          "type": "object"
        },
        "regex": {
          "title": "Regex",
          "type": "string"
        },
        "registry": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Mock registry key, e.g. 'fssai'",
          "title": "Registry"
        }
      },
      "required": [
        "id",
        "role",
        "name",
        "regex"
      ],
      "title": "DocSpec",
      "type": "object"
    },
    "GradingRules": {
      "additionalProperties": false,
      "properties": {
        "scale": {
          "items": {
            "type": "string"
          },
          "title": "Scale",
          "type": "array"
        },
        "params": {
          "additionalProperties": true,
          "title": "Params",
          "type": "object"
        }
      },
      "title": "GradingRules",
      "type": "object"
    },
    "OrderLine": {
      "additionalProperties": false,
      "properties": {
        "sku": {
          "title": "Sku",
          "type": "string"
        },
        "qty": {
          "title": "Qty",
          "type": "string"
        },
        "unit": {
          "title": "Unit",
          "type": "string"
        },
        "price": {
          "description": "Per unit",
          "title": "Price",
          "type": "string"
        }
      },
      "required": [
        "sku",
        "qty",
        "unit",
        "price"
      ],
      "title": "OrderLine",
      "type": "object"
    },
    "OrderProposal": {
      "additionalProperties": false,
      "description": "One immutable version of an order. A counter is a new version (see `next_version`).",
      "properties": {
        "order_id": {
          "title": "Order Id",
          "type": "string"
        },
        "version": {
          "minimum": 1,
          "title": "Version",
          "type": "integer"
        },
        "retailer_id": {
          "title": "Retailer Id",
          "type": "string"
        },
        "vendor_id": {
          "title": "Vendor Id",
          "type": "string"
        },
        "store_id": {
          "title": "Store Id",
          "type": "string"
        },
        "lines": {
          "items": {
            "$ref": "#/$defs/OrderLine"
          },
          "minItems": 1,
          "title": "Lines",
          "type": "array"
        },
        "pickup_at": {
          "format": "date-time",
          "title": "Pickup At",
          "type": "string"
        },
        "payment_days": {
          "minimum": 0,
          "title": "Payment Days",
          "type": "integer"
        },
        "currency": {
          "title": "Currency",
          "type": "string"
        },
        "terms_version": {
          "title": "Terms Version",
          "type": "string"
        }
      },
      "required": [
        "order_id",
        "version",
        "retailer_id",
        "vendor_id",
        "store_id",
        "lines",
        "pickup_at",
        "payment_days",
        "currency",
        "terms_version"
      ],
      "title": "OrderProposal",
      "type": "object"
    },
    "QualityThresholds": {
      "additionalProperties": false,
      "properties": {
        "min_grade": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Min Grade"
        },
        "min_shelf_life_days": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Min Shelf Life Days"
        },
        "max_reject_fraction": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Reject Fraction"
        }
      },
      "title": "QualityThresholds",
      "type": "object"
    },
    "RetailerPolicy": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "version": {
          "minimum": 1,
          "title": "Version",
          "type": "integer"
        },
        "auto_order_max_value": {
          "description": "In the Country Pack currency",
          "title": "Auto Order Max Value",
          "type": "string"
        },
        "auto_accept_counter_max_delta": {
          "description": "Max relative change in order value a counter may make and still auto-accept",
          "maximum": 1,
          "minimum": 0,
          "title": "Auto Accept Counter Max Delta",
          "type": "number"
        },
        "new_vendor_needs_human": {
          "default": true,
          "title": "New Vendor Needs Human",
          "type": "boolean"
        },
        "listing_publish_min_confidence": {
          "default": 0.8,
          "maximum": 1,
          "minimum": 0,
          "title": "Listing Publish Min Confidence",
          "type": "number"
        }
      },
      "required": [
        "id",
        "version",
        "auto_order_max_value",
        "auto_accept_counter_max_delta"
      ],
      "title": "RetailerPolicy",
      "type": "object"
    },
    "RetailerProfile": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "version": {
          "minimum": 1,
          "title": "Version",
          "type": "integer"
        },
        "retailer_type": {
          "title": "Retailer Type",
          "type": "string"
        },
        "ordering_mode": {
          "enum": [
            "auto_replenish",
            "manual",
            "standing_order"
          ],
          "title": "Ordering Mode",
          "type": "string"
        },
        "categories": {
          "items": {
            "$ref": "#/$defs/Category"
          },
          "title": "Categories",
          "type": "array"
        },
        "quality_thresholds": {
          "$ref": "#/$defs/QualityThresholds"
        },
        "term_templates": {
          "items": {
            "$ref": "#/$defs/TermTemplate"
          },
          "title": "Term Templates",
          "type": "array"
        },
        "specialists": {
          "description": "Agent ids to load",
          "items": {
            "type": "string"
          },
          "title": "Specialists",
          "type": "array"
        },
        "workflow_set": {
          "default": "default",
          "title": "Workflow Set",
          "type": "string"
        },
        "claims_requiring_proof": {
          "description": "Product claims flagged for review, e.g. organic",
          "items": {
            "type": "string"
          },
          "title": "Claims Requiring Proof",
          "type": "array"
        }
      },
      "required": [
        "id",
        "version",
        "retailer_type",
        "ordering_mode"
      ],
      "title": "RetailerProfile",
      "type": "object"
    },
    "TermTemplate": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "payment_days": {
          "minimum": 0,
          "title": "Payment Days",
          "type": "integer"
        },
        "description": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Description",
          "type": "object"
        }
      },
      "required": [
        "id",
        "payment_days"
      ],
      "title": "TermTemplate",
      "type": "object"
    },
    "Workflow": {
      "additionalProperties": false,
      "properties": {
        "job_type": {
          "title": "Job Type",
          "type": "string"
        },
        "steps": {
          "items": {
            "$ref": "#/$defs/WorkflowStep"
          },
          "title": "Steps",
          "type": "array"
        }
      },
      "required": [
        "job_type",
        "steps"
      ],
      "title": "Workflow",
      "type": "object"
    },
    "WorkflowSet": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "version": {
          "minimum": 1,
          "title": "Version",
          "type": "integer"
        },
        "workflows": {
          "items": {
            "$ref": "#/$defs/Workflow"
          },
          "title": "Workflows",
          "type": "array"
        }
      },
      "required": [
        "id",
        "version",
        "workflows"
      ],
      "title": "WorkflowSet",
      "type": "object"
    },
    "WorkflowStep": {
      "additionalProperties": false,
      "properties": {
        "capability": {
          "description": "Capability or wildcard, e.g. 'grade.*'",
          "title": "Capability",
          "type": "string"
        },
        "optional": {
          "default": false,
          "description": "Skip when no loaded specialist offers it",
          "title": "Optional",
          "type": "boolean"
        }
      },
      "required": [
        "capability"
      ],
      "title": "WorkflowStep",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "active_config": {
      "$ref": "#/$defs/ActiveConfig"
    },
    "original": {
      "$ref": "#/$defs/OrderProposal"
    },
    "counter": {
      "$ref": "#/$defs/OrderProposal"
    }
  },
  "required": [
    "active_config",
    "original",
    "counter"
  ],
  "title": "CounterReviewIn",
  "type": "object"
}
