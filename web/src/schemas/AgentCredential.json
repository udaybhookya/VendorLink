{
  "additionalProperties": false,
  "description": "The gateway's record of one agent: identity, key, permissions and status.\n\nParty agents (one per vendor or retailer) hold their own key. Agents hosted in-process by a\nservice (Guardian, Orchestrator, specialists) are registered by that host and act under it.",
  "properties": {
    "agent_id": {
      "title": "Agent Id",
      "type": "string"
    },
    "party_type": {
      "enum": [
        "vendor",
        "retailer",
        "platform"
      ],
      "title": "Party Type",
      "type": "string"
    },
    "kind": {
      "default": "party",
      "enum": [
        "party",
        "core",
        "specialist",
        "channel",
        "host"
      ],
      "title": "Kind",
      "type": "string"
    },
    "on_behalf_of": {
      "description": "Vendor or retailer id the agent acts for",
      "title": "On Behalf Of",
      "type": "string"
    },
    "display_name": {
      "default": "",
      "title": "Display Name",
      "type": "string"
    },
    "host": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Deployable running it in-process",
      "title": "Host"
    },
    "public_key": {
      "description": "Raw Ed25519 public key, base64url (host's key if hosted)",
      "title": "Public Key",
      "type": "string"
    },
    "key_fingerprint": {
      "default": "",
      "title": "Key Fingerprint",
      "type": "string"
    },
    "endpoint": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "A2A base URL the gateway forwards to",
      "title": "Endpoint"
    },
    "permissions": {
      "description": "Allowed skills/capabilities; empty = policy defaults",
      "items": {
        "type": "string"
      },
      "title": "Permissions",
      "type": "array"
    },
    "rate_limit_per_min": {
      "default": 120,
      "minimum": 0,
      "title": "Rate Limit Per Min",
      "type": "integer"
    },
    "status": {
      "default": "active",
      "enum": [
        "active",
        "suspended",
        "quarantined",
        "revoked"
      ],
      "title": "Status",
      "type": "string"
    },
    "status_reason": {
      "default": "",
      "title": "Status Reason",
      "type": "string"
    },
    "issued_at": {
      "format": "date-time",
      "title": "Issued At",
      "type": "string"
    },
    "revoked_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Revoked At"
    },
    "last_seen": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Last Seen"
    },
    "key_rotation_requested": {
      "default": false,
      "title": "Key Rotation Requested",
      "type": "boolean"
    },
    "sessions_valid_after": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Tokens issued before this are void (end session)",
      "title": "Sessions Valid After"
    }
  },
  "required": [
    "agent_id",
    "party_type",
    "on_behalf_of",
    "public_key",
    "issued_at"
  ],
  "title": "AgentCredential",
  "type": "object"
}
