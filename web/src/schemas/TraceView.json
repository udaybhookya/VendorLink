{
  "$defs": {
    "AgentEvent": {
      "additionalProperties": false,
      "description": "Every operational fact in one shape: calls, decisions, logins, permission checks,\nscreening and control actions. The audit log stays the formal, tamper-evident record.",
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "ts": {
          "format": "date-time",
          "title": "Ts",
          "type": "string"
        },
        "type": {
          "enum": [
            "call",
            "decision",
            "login",
            "permission_check",
            "screening",
            "control",
            "security",
            "audit",
            "ask",
            "answer",
            "notify"
          ],
          "title": "Type",
          "type": "string"
        },
        "agent_id": {
          "title": "Agent Id",
          "type": "string"
        },
        "on_behalf_of": {
          "default": "",
          "title": "On Behalf Of",
          "type": "string"
        },
        "action": {
          "description": "Capability, skill, audit action or control verb",
          "title": "Action",
          "type": "string"
        },
        "target": {
          "default": "",
          "title": "Target",
          "type": "string"
        },
        "outcome": {
          "default": "ok",
          "enum": [
            "ok",
            "denied",
            "error"
          ],
          "title": "Outcome",
          "type": "string"
        },
        "latency_ms": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Latency Ms"
        },
        "trace_id": {
          "default": "",
          "title": "Trace Id",
          "type": "string"
        },
        "span_id": {
          "default": "",
          "title": "Span Id",
          "type": "string"
        },
        "actor": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Person, for control actions",
          "title": "Actor"
        },
        "attrs": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "integer"
              },
              {
                "type": "number"
              },
              {
                "type": "boolean"
              }
            ]
          },
          "title": "Attrs",
          "type": "object"
        }
      },
      "required": [
        "id",
        "ts",
        "type",
        "agent_id",
        "action"
      ],
      "title": "AgentEvent",
      "type": "object"
    },
    "TraceSummary": {
      "additionalProperties": false,
      "properties": {
        "trace_id": {
          "title": "Trace Id",
          "type": "string"
        },
        "started": {
          "format": "date-time",
          "title": "Started",
          "type": "string"
        },
        "duration_ms": {
          "title": "Duration Ms",
          "type": "number"
        },
        "agents": {
          "items": {
            "type": "string"
          },
          "title": "Agents",
          "type": "array"
        },
        "actions": {
          "items": {
            "type": "string"
          },
          "title": "Actions",
          "type": "array"
        },
        "outcome": {
          "enum": [
            "ok",
            "denied",
            "error"
          ],
          "title": "Outcome",
          "type": "string"
        },
        "events": {
          "title": "Events",
          "type": "integer"
        }
      },
      "required": [
        "trace_id",
        "started",
        "duration_ms",
        "agents",
        "actions",
        "outcome",
        "events"
      ],
      "title": "TraceSummary",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "summary": {
      "$ref": "#/$defs/TraceSummary"
    },
    "events": {
      "items": {
        "$ref": "#/$defs/AgentEvent"
      },
      "title": "Events",
      "type": "array"
    }
  },
  "required": [
    "summary",
    "events"
  ],
  "title": "TraceView",
  "type": "object"
}
