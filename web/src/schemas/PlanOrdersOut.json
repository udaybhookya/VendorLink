{
  "$defs": {
    "DemandLine": {
      "additionalProperties": false,
      "properties": {
        "sku": {
          "title": "Sku",
          "type": "string"
        },
        "qty": {
          "exclusiveMinimum": 0,
          "title": "Qty",
          "type": "integer"
        },
        "unit": {
          "title": "Unit",
          "type": "string"
        },
        "pickup_local": {
          "pattern": "^\\d{2}:\\d{2}$",
          "title": "Pickup Local",
          "type": "string"
        }
      },
      "required": [
        "sku",
        "qty",
        "unit",
        "pickup_local"
      ],
      "title": "DemandLine",
      "type": "object"
    },
    "OrderLine": {
      "additionalProperties": false,
      "properties": {
        "sku": {
          "title": "Sku",
          "type": "string"
        },
        "qty": {
          "title": "Qty",
          "type": "string"
        },
        "unit": {
          "title": "Unit",
          "type": "string"
        },
        "price": {
          "description": "Per unit",
          "title": "Price",
          "type": "string"
        }
      },
      "required": [
        "sku",
        "qty",
        "unit",
        "price"
      ],
      "title": "OrderLine",
      "type": "object"
    },
    "OrderPlanOut": {
      "additionalProperties": false,
      "properties": {
        "proposals": {
          "items": {
            "$ref": "#/$defs/OrderProposal"
          },
          "title": "Proposals",
          "type": "array"
        },
        "notes": {
          "default": "",
          "title": "Notes",
          "type": "string"
        },
        "unmatched": {
          "description": "Demand the vendor has no published listing for",
          "items": {
            "$ref": "#/$defs/DemandLine"
          },
          "title": "Unmatched",
          "type": "array"
        }
      },
      "required": [
        "proposals"
      ],
      "title": "OrderPlanOut",
      "type": "object"
    },
    "OrderProposal": {
      "additionalProperties": false,
      "description": "One immutable version of an order. A counter is a new version (see `next_version`).",
      "properties": {
        "order_id": {
          "title": "Order Id",
          "type": "string"
        },
        "version": {
          "minimum": 1,
          "title": "Version",
          "type": "integer"
        },
        "retailer_id": {
          "title": "Retailer Id",
          "type": "string"
        },
        "vendor_id": {
          "title": "Vendor Id",
          "type": "string"
        },
        "store_id": {
          "title": "Store Id",
          "type": "string"
        },
        "lines": {
          "items": {
            "$ref": "#/$defs/OrderLine"
          },
          "minItems": 1,
          "title": "Lines",
          "type": "array"
        },
        "pickup_at": {
          "format": "date-time",
          "title": "Pickup At",
          "type": "string"
        },
        "payment_days": {
          "minimum": 0,
          "title": "Payment Days",
          "type": "integer"
        },
        "currency": {
          "title": "Currency",
          "type": "string"
        },
        "terms_version": {
          "title": "Terms Version",
          "type": "string"
        }
      },
      "required": [
        "order_id",
        "version",
        "retailer_id",
        "vendor_id",
        "store_id",
        "lines",
        "pickup_at",
        "payment_days",
        "currency",
        "terms_version"
      ],
      "title": "OrderProposal",
      "type": "object"
    },
    "PolicyGate": {
      "additionalProperties": false,
      "properties": {
        "order_id": {
          "title": "Order Id",
          "type": "string"
        },
        "auto": {
          "title": "Auto",
          "type": "boolean"
        },
        "reason": {
          "default": "",
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "order_id",
        "auto"
      ],
      "title": "PolicyGate",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "plan": {
      "$ref": "#/$defs/OrderPlanOut"
    },
    "gates": {
      "items": {
        "$ref": "#/$defs/PolicyGate"
      },
      "title": "Gates",
      "type": "array"
    },
    "ran": {
      "items": {
        "type": "string"
      },
      "title": "Ran",
      "type": "array"
    }
  },
  "required": [
    "plan",
    "gates",
    "ran"
  ],
  "title": "PlanOrdersOut",
  "type": "object"
}
