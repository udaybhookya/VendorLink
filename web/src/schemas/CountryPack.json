{
  "$defs": {
    "DocSpec": {
      "additionalProperties": false,
      "description": "An identity document or food-safety registration, with its number format.",
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "role": {
          "description": "Generic role a Business Profile requires, e.g. 'identity'",
          "title": "Role",
          "type": "string"
        },
        "name": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Name",
          "type": "object"
        },
        "regex": {
          "title": "Regex",
          "type": "string"
        },
        "registry": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Mock registry key, e.g. 'fssai'",
          "title": "Registry"
        }
      },
      "required": [
        "id",
        "role",
        "name",
        "regex"
      ],
      "title": "DocSpec",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "code": {
      "pattern": "^[A-Z]{2}$",
      "title": "Code",
      "type": "string"
    },
    "version": {
      "minimum": 1,
      "title": "Version",
      "type": "integer"
    },
    "name": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Name",
      "type": "object"
    },
    "languages": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Languages",
      "type": "array"
    },
    "default_language": {
      "title": "Default Language",
      "type": "string"
    },
    "currency": {
      "pattern": "^[A-Z]{3}$",
      "title": "Currency",
      "type": "string"
    },
    "timezone": {
      "title": "Timezone",
      "type": "string"
    },
    "local_units": {
      "items": {
        "type": "string"
      },
      "title": "Local Units",
      "type": "array"
    },
    "id_docs": {
      "items": {
        "$ref": "#/$defs/DocSpec"
      },
      "title": "Id Docs",
      "type": "array"
    },
    "food_safety_regs": {
      "items": {
        "$ref": "#/$defs/DocSpec"
      },
      "title": "Food Safety Regs",
      "type": "array"
    },
    "consent_wording": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Consent Wording",
      "type": "object"
    },
    "label_keywords": {
      "additionalProperties": {
        "items": {
          "type": "string"
        },
        "type": "array"
      },
      "description": "Label field → words that introduce it on a label; `halal` → halal marks",
      "title": "Label Keywords",
      "type": "object"
    }
  },
  "required": [
    "code",
    "version",
    "name",
    "languages",
    "default_language",
    "currency",
    "timezone"
  ],
  "title": "CountryPack",
  "type": "object"
}
