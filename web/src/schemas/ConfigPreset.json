{
  "$defs": {
    "ConfigRef": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "version": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "None = latest",
          "title": "Version"
        }
      },
      "required": [
        "id"
      ],
      "title": "ConfigRef",
      "type": "object"
    },
    "ConfigRefs": {
      "additionalProperties": false,
      "properties": {
        "business_profile": {
          "$ref": "#/$defs/ConfigRef"
        },
        "retailer_profile": {
          "$ref": "#/$defs/ConfigRef"
        },
        "country_pack": {
          "$ref": "#/$defs/ConfigRef"
        },
        "retailer_policy": {
          "$ref": "#/$defs/ConfigRef"
        },
        "workflows": {
          "anyOf": [
            {
              "$ref": "#/$defs/ConfigRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "None = profile's set"
        }
      },
      "required": [
        "business_profile",
        "retailer_profile",
        "country_pack",
        "retailer_policy"
      ],
      "title": "ConfigRefs",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "A named bundle of refs (config A, config B) used for seeding and the demo switch.",
  "properties": {
    "id": {
      "title": "Id",
      "type": "string"
    },
    "label": {
      "title": "Label",
      "type": "string"
    },
    "refs": {
      "$ref": "#/$defs/ConfigRefs"
    }
  },
  "required": [
    "id",
    "label",
    "refs"
  ],
  "title": "ConfigPreset",
  "type": "object"
}
