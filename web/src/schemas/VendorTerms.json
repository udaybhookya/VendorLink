{
  "$defs": {
    "TermsProposal": {
      "additionalProperties": false,
      "properties": {
        "terms_id": {
          "title": "Terms Id",
          "type": "string"
        },
        "retailer_id": {
          "title": "Retailer Id",
          "type": "string"
        },
        "vendor_id": {
          "title": "Vendor Id",
          "type": "string"
        },
        "template_id": {
          "title": "Template Id",
          "type": "string"
        },
        "payment_days": {
          "minimum": 0,
          "title": "Payment Days",
          "type": "integer"
        },
        "description": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Description",
          "type": "object"
        }
      },
      "required": [
        "terms_id",
        "retailer_id",
        "vendor_id",
        "template_id",
        "payment_days"
      ],
      "title": "TermsProposal",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Terms a retailer proposed, as the vendor sees them, with her Guardian's verdict.",
  "properties": {
    "terms": {
      "$ref": "#/$defs/TermsProposal"
    },
    "verdict": {
      "description": "WITHIN_RULES, PAYMENT_TOO_LATE or NO_STANDING_MANDATE",
      "title": "Verdict",
      "type": "string"
    },
    "status": {
      "default": "proposed",
      "enum": [
        "proposed",
        "accepted",
        "declined"
      ],
      "title": "Status",
      "type": "string"
    },
    "received_at": {
      "format": "date-time",
      "title": "Received At",
      "type": "string"
    },
    "answered_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Answered At"
    }
  },
  "required": [
    "terms",
    "verdict",
    "received_at"
  ],
  "title": "VendorTerms",
  "type": "object"
}
