{
  "$defs": {
    "Choice": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "description": "Machine value, e.g. approve",
          "title": "Id",
          "type": "string"
        },
        "label": {
          "title": "Label",
          "type": "string"
        },
        "words": {
          "description": "Extra words that mean this choice",
          "items": {
            "type": "string"
          },
          "title": "Words",
          "type": "array"
        }
      },
      "required": [
        "id",
        "label"
      ],
      "title": "Choice",
      "type": "object"
    },
    "DocCheck": {
      "additionalProperties": false,
      "properties": {
        "doc_type": {
          "title": "Doc Type",
          "type": "string"
        },
        "status": {
          "enum": [
            "pass",
            "fail",
            "needs_review"
          ],
          "title": "Status",
          "type": "string"
        },
        "code": {
          "description": "Machine code, e.g. NAME_MISMATCH, LICENCE_EXPIRED",
          "title": "Code",
          "type": "string"
        },
        "detail": {
          "default": "",
          "title": "Detail",
          "type": "string"
        }
      },
      "required": [
        "doc_type",
        "status",
        "code"
      ],
      "title": "DocCheck",
      "type": "object"
    },
    "InfoRequest": {
      "additionalProperties": false,
      "description": "What an agent needs from a person to continue. Emitted by specialists and jobs.",
      "properties": {
        "field": {
          "description": "What is missing, e.g. price, qty, doc:aadhaar",
          "title": "Field",
          "type": "string"
        },
        "ask": {
          "description": "Role to ask: vendor, buyer, category_manager, ops",
          "title": "Ask",
          "type": "string"
        },
        "kind": {
          "default": "missing_info",
          "enum": [
            "missing_info",
            "approval",
            "consent",
            "review",
            "notice"
          ],
          "title": "Kind",
          "type": "string"
        },
        "answer_type": {
          "default": "text",
          "enum": [
            "choice",
            "number",
            "text",
            "date"
          ],
          "title": "Answer Type",
          "type": "string"
        },
        "question_key": {
          "description": "i18n key for the question, e.g. hitl.q.price",
          "title": "Question Key",
          "type": "string"
        },
        "params": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "integer"
              },
              {
                "type": "number"
              }
            ]
          },
          "title": "Params",
          "type": "object"
        },
        "choices": {
          "items": {
            "$ref": "#/$defs/Choice"
          },
          "title": "Choices",
          "type": "array"
        }
      },
      "required": [
        "field",
        "ask",
        "question_key"
      ],
      "title": "InfoRequest",
      "type": "object"
    },
    "ListingFlag": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "description": "Machine code, e.g. UNSUPPORTED_CLAIM_ORGANIC",
          "title": "Code",
          "type": "string"
        },
        "detail": {
          "default": "",
          "title": "Detail",
          "type": "string"
        }
      },
      "required": [
        "code"
      ],
      "title": "ListingFlag",
      "type": "object"
    },
    "VendorCheckOut": {
      "additionalProperties": false,
      "properties": {
        "checks": {
          "items": {
            "$ref": "#/$defs/DocCheck"
          },
          "title": "Checks",
          "type": "array"
        },
        "flags": {
          "items": {
            "$ref": "#/$defs/ListingFlag"
          },
          "title": "Flags",
          "type": "array"
        },
        "passed": {
          "title": "Passed",
          "type": "boolean"
        },
        "requests": {
          "items": {
            "$ref": "#/$defs/InfoRequest"
          },
          "title": "Requests",
          "type": "array"
        }
      },
      "required": [
        "passed"
      ],
      "title": "VendorCheckOut",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "result": {
      "$ref": "#/$defs/VendorCheckOut"
    },
    "ran": {
      "items": {
        "type": "string"
      },
      "title": "Ran",
      "type": "array"
    },
    "status": {
      "enum": [
        "approved",
        "pending_approval",
        "checks_failed"
      ],
      "title": "Status",
      "type": "string"
    }
  },
  "required": [
    "result",
    "ran",
    "status"
  ],
  "title": "OnboardOut",
  "type": "object"
}
