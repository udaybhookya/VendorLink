{
  "$defs": {
    "Workflow": {
      "additionalProperties": false,
      "properties": {
        "job_type": {
          "title": "Job Type",
          "type": "string"
        },
        "steps": {
          "items": {
            "$ref": "#/$defs/WorkflowStep"
          },
          "title": "Steps",
          "type": "array"
        }
      },
      "required": [
        "job_type",
        "steps"
      ],
      "title": "Workflow",
      "type": "object"
    },
    "WorkflowStep": {
      "additionalProperties": false,
      "properties": {
        "capability": {
          "description": "Capability or wildcard, e.g. 'grade.*'",
          "title": "Capability",
          "type": "string"
        },
        "optional": {
          "default": false,
          "description": "Skip when no loaded specialist offers it",
          "title": "Optional",
          "type": "boolean"
        }
      },
      "required": [
        "capability"
      ],
      "title": "WorkflowStep",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "id": {
      "title": "Id",
      "type": "string"
    },
    "version": {
      "minimum": 1,
      "title": "Version",
      "type": "integer"
    },
    "workflows": {
      "items": {
        "$ref": "#/$defs/Workflow"
      },
      "title": "Workflows",
      "type": "array"
    }
  },
  "required": [
    "id",
    "version",
    "workflows"
  ],
  "title": "WorkflowSet",
  "type": "object"
}
