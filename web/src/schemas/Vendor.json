{
  "$defs": {
    "ListingRules": {
      "additionalProperties": false,
      "description": "What her agent may approve on her behalf when the retailer's agents improve a listing.\nAnything outside these rules is shown to her first.",
      "properties": {
        "price_must_match": {
          "default": true,
          "description": "Price and quantity must be numbers she said or answered",
          "title": "Price Must Match",
          "type": "boolean"
        },
        "allow_text_rewrite": {
          "default": true,
          "description": "Title and description reworded from her own facts",
          "title": "Allow Text Rewrite",
          "type": "boolean"
        },
        "allow_ai_images": {
          "default": false,
          "description": "Use an AI-enhanced photo of her product without asking",
          "title": "Allow Ai Images",
          "type": "boolean"
        }
      },
      "title": "ListingRules",
      "type": "object"
    },
    "VendorDoc": {
      "additionalProperties": false,
      "properties": {
        "doc_type": {
          "description": "A DocSpec id from the Country Pack",
          "title": "Doc Type",
          "type": "string"
        },
        "number": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Number"
        },
        "uri": {
          "title": "Uri",
          "type": "string"
        },
        "status": {
          "default": "submitted",
          "enum": [
            "submitted",
            "verified",
            "failed"
          ],
          "title": "Status",
          "type": "string"
        },
        "failure_reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Failure Reason"
        }
      },
      "required": [
        "doc_type",
        "uri"
      ],
      "title": "VendorDoc",
      "type": "object"
    },
    "VendorStatus": {
      "enum": [
        "draft",
        "verifying",
        "pending_approval",
        "active"
      ],
      "title": "VendorStatus",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "id": {
      "title": "Id",
      "type": "string"
    },
    "display_name": {
      "title": "Display Name",
      "type": "string"
    },
    "legal_name": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Legal Name"
    },
    "business_profile": {
      "title": "Business Profile",
      "type": "string"
    },
    "country": {
      "title": "Country",
      "type": "string"
    },
    "language": {
      "title": "Language",
      "type": "string"
    },
    "status": {
      "$ref": "#/$defs/VendorStatus",
      "default": "draft"
    },
    "docs": {
      "items": {
        "$ref": "#/$defs/VendorDoc"
      },
      "title": "Docs",
      "type": "array"
    },
    "agent_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Agent Id"
    },
    "retailers": {
      "description": "Retailers she works with",
      "items": {
        "type": "string"
      },
      "title": "Retailers",
      "type": "array"
    },
    "email": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Optional: for nudges back to the app",
      "title": "Email"
    },
    "listing_rules": {
      "$ref": "#/$defs/ListingRules"
    },
    "synthetic": {
      "default": true,
      "title": "Synthetic",
      "type": "boolean"
    }
  },
  "required": [
    "id",
    "display_name",
    "business_profile",
    "country",
    "language"
  ],
  "title": "Vendor",
  "type": "object"
}
