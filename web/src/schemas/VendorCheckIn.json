{
  "$defs": {
    "AttributeSpec": {
      "additionalProperties": false,
      "properties": {
        "key": {
          "title": "Key",
          "type": "string"
        },
        "label": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Label",
          "type": "object"
        },
        "type": {
          "enum": [
            "str",
            "int",
            "decimal",
            "bool",
            "enum"
          ],
          "title": "Type",
          "type": "string"
        },
        "required": {
          "default": false,
          "title": "Required",
          "type": "boolean"
        },
        "options": {
          "items": {
            "type": "string"
          },
          "title": "Options",
          "type": "array"
        }
      },
      "required": [
        "key",
        "label",
        "type"
      ],
      "title": "AttributeSpec",
      "type": "object"
    },
    "BusinessProfile": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "version": {
          "minimum": 1,
          "title": "Version",
          "type": "integer"
        },
        "name": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Name",
          "type": "object"
        },
        "attributes": {
          "items": {
            "$ref": "#/$defs/AttributeSpec"
          },
          "title": "Attributes",
          "type": "array"
        },
        "units": {
          "items": {
            "type": "string"
          },
          "title": "Units",
          "type": "array"
        },
        "grading_rules": {
          "$ref": "#/$defs/GradingRules"
        },
        "required_docs": {
          "description": "DocSpec roles; the Country Pack names the documents",
          "items": {
            "type": "string"
          },
          "title": "Required Docs",
          "type": "array"
        },
        "specialists": {
          "description": "Agent ids to load",
          "items": {
            "type": "string"
          },
          "title": "Specialists",
          "type": "array"
        }
      },
      "required": [
        "id",
        "version",
        "name",
        "units"
      ],
      "title": "BusinessProfile",
      "type": "object"
    },
    "CountryPack": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "pattern": "^[A-Z]{2}$",
          "title": "Code",
          "type": "string"
        },
        "version": {
          "minimum": 1,
          "title": "Version",
          "type": "integer"
        },
        "name": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Name",
          "type": "object"
        },
        "languages": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Languages",
          "type": "array"
        },
        "default_language": {
          "title": "Default Language",
          "type": "string"
        },
        "currency": {
          "pattern": "^[A-Z]{3}$",
          "title": "Currency",
          "type": "string"
        },
        "timezone": {
          "title": "Timezone",
          "type": "string"
        },
        "local_units": {
          "items": {
            "type": "string"
          },
          "title": "Local Units",
          "type": "array"
        },
        "id_docs": {
          "items": {
            "$ref": "#/$defs/DocSpec"
          },
          "title": "Id Docs",
          "type": "array"
        },
        "food_safety_regs": {
          "items": {
            "$ref": "#/$defs/DocSpec"
          },
          "title": "Food Safety Regs",
          "type": "array"
        },
        "consent_wording": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Consent Wording",
          "type": "object"
        },
        "label_keywords": {
          "additionalProperties": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "description": "Label field → words that introduce it on a label; `halal` → halal marks",
          "title": "Label Keywords",
          "type": "object"
        }
      },
      "required": [
        "code",
        "version",
        "name",
        "languages",
        "default_language",
        "currency",
        "timezone"
      ],
      "title": "CountryPack",
      "type": "object"
    },
    "DocSpec": {
      "additionalProperties": false,
      "description": "An identity document or food-safety registration, with its number format.",
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "role": {
          "description": "Generic role a Business Profile requires, e.g. 'identity'",
          "title": "Role",
          "type": "string"
        },
        "name": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Name",
          "type": "object"
        },
        "regex": {
          "title": "Regex",
          "type": "string"
        },
        "registry": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Mock registry key, e.g. 'fssai'",
          "title": "Registry"
        }
      },
      "required": [
        "id",
        "role",
        "name",
        "regex"
      ],
      "title": "DocSpec",
      "type": "object"
    },
    "GradingRules": {
      "additionalProperties": false,
      "properties": {
        "scale": {
          "items": {
            "type": "string"
          },
          "title": "Scale",
          "type": "array"
        },
        "params": {
          "additionalProperties": true,
          "title": "Params",
          "type": "object"
        }
      },
      "title": "GradingRules",
      "type": "object"
    },
    "Listing": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "vendor_id": {
          "title": "Vendor Id",
          "type": "string"
        },
        "sku_name": {
          "title": "Sku Name",
          "type": "string"
        },
        "category": {
          "title": "Category",
          "type": "string"
        },
        "unit": {
          "title": "Unit",
          "type": "string"
        },
        "price": {
          "title": "Price",
          "type": "string"
        },
        "currency": {
          "title": "Currency",
          "type": "string"
        },
        "qty": {
          "title": "Qty",
          "type": "string"
        },
        "grade": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Grade"
        },
        "shelf_life_days": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Shelf Life Days"
        },
        "attributes": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "integer"
              },
              {
                "type": "number"
              },
              {
                "type": "boolean"
              }
            ]
          },
          "title": "Attributes",
          "type": "object"
        },
        "photos": {
          "items": {
            "type": "string"
          },
          "title": "Photos",
          "type": "array"
        },
        "flags": {
          "items": {
            "$ref": "#/$defs/ListingFlag"
          },
          "title": "Flags",
          "type": "array"
        },
        "confidence": {
          "default": 0.0,
          "maximum": 1,
          "minimum": 0,
          "title": "Confidence",
          "type": "number"
        },
        "status": {
          "default": "draft",
          "enum": [
            "draft",
            "needs_review",
            "published",
            "rejected"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "id",
        "vendor_id",
        "sku_name",
        "category",
        "unit",
        "price",
        "currency",
        "qty"
      ],
      "title": "Listing",
      "type": "object"
    },
    "ListingFlag": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "description": "Machine code, e.g. UNSUPPORTED_CLAIM_ORGANIC",
          "title": "Code",
          "type": "string"
        },
        "detail": {
          "default": "",
          "title": "Detail",
          "type": "string"
        }
      },
      "required": [
        "code"
      ],
      "title": "ListingFlag",
      "type": "object"
    },
    "Vendor": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "display_name": {
          "title": "Display Name",
          "type": "string"
        },
        "legal_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Legal Name"
        },
        "business_profile": {
          "title": "Business Profile",
          "type": "string"
        },
        "country": {
          "title": "Country",
          "type": "string"
        },
        "language": {
          "title": "Language",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/VendorStatus",
          "default": "draft"
        },
        "docs": {
          "items": {
            "$ref": "#/$defs/VendorDoc"
          },
          "title": "Docs",
          "type": "array"
        },
        "agent_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Agent Id"
        },
        "retailers": {
          "description": "Retailers she works with",
          "items": {
            "type": "string"
          },
          "title": "Retailers",
          "type": "array"
        },
        "email": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Optional: for nudges back to the app",
          "title": "Email"
        },
        "synthetic": {
          "default": true,
          "title": "Synthetic",
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "display_name",
        "business_profile",
        "country",
        "language"
      ],
      "title": "Vendor",
      "type": "object"
    },
    "VendorDoc": {
      "additionalProperties": false,
      "properties": {
        "doc_type": {
          "description": "A DocSpec id from the Country Pack",
          "title": "Doc Type",
          "type": "string"
        },
        "number": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Number"
        },
        "uri": {
          "title": "Uri",
          "type": "string"
        },
        "status": {
          "default": "submitted",
          "enum": [
            "submitted",
            "verified",
            "failed"
          ],
          "title": "Status",
          "type": "string"
        },
        "failure_reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Failure Reason"
        }
      },
      "required": [
        "doc_type",
        "uri"
      ],
      "title": "VendorDoc",
      "type": "object"
    },
    "VendorStatus": {
      "enum": [
        "draft",
        "verifying",
        "pending_approval",
        "active"
      ],
      "title": "VendorStatus",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "Input to onboard_vendor steps (vendor.verify, compliance.check).",
  "properties": {
    "vendor": {
      "$ref": "#/$defs/Vendor"
    },
    "legal_name": {
      "title": "Legal Name",
      "type": "string"
    },
    "doc_numbers": {
      "additionalProperties": {
        "type": "string"
      },
      "description": "DocSpec id → number",
      "title": "Doc Numbers",
      "type": "object"
    },
    "business_profile": {
      "$ref": "#/$defs/BusinessProfile"
    },
    "country_pack": {
      "$ref": "#/$defs/CountryPack"
    },
    "listings": {
      "items": {
        "$ref": "#/$defs/Listing"
      },
      "title": "Listings",
      "type": "array"
    }
  },
  "required": [
    "vendor",
    "legal_name",
    "doc_numbers",
    "business_profile",
    "country_pack"
  ],
  "title": "VendorCheckIn",
  "type": "object"
}
