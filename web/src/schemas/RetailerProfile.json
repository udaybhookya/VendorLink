{
  "$defs": {
    "CatalogueStandards": {
      "additionalProperties": false,
      "description": "The retailer's bar for a listing: photo and text. Checked by the catalogue specialists.",
      "properties": {
        "image": {
          "$ref": "#/$defs/ImageStandards"
        },
        "text": {
          "$ref": "#/$defs/TextStandards"
        }
      },
      "title": "CatalogueStandards",
      "type": "object"
    },
    "Category": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "name": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Name",
          "type": "object"
        },
        "units": {
          "items": {
            "type": "string"
          },
          "title": "Units",
          "type": "array"
        }
      },
      "required": [
        "id",
        "name"
      ],
      "title": "Category",
      "type": "object"
    },
    "ImageLook": {
      "additionalProperties": false,
      "description": "One styled direction for an AI version of her photo: the backdrop, light, angle and mood.\nThe product itself never changes; only how it is staged.",
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "name": {
          "additionalProperties": {
            "type": "string"
          },
          "description": "Shown under the photo, by language code",
          "title": "Name",
          "type": "object"
        },
        "scene": {
          "description": "For the image model: backdrop, surface, light, angle, mood",
          "title": "Scene",
          "type": "string"
        }
      },
      "required": [
        "id",
        "name",
        "scene"
      ],
      "title": "ImageLook",
      "type": "object"
    },
    "ImageStandards": {
      "additionalProperties": false,
      "description": "What a catalogue-ready product photo means to this retailer.",
      "properties": {
        "min_width": {
          "default": 600,
          "minimum": 1,
          "title": "Min Width",
          "type": "integer"
        },
        "min_height": {
          "default": 600,
          "minimum": 1,
          "title": "Min Height",
          "type": "integer"
        },
        "min_sharpness": {
          "default": 8.0,
          "description": "Edge strength vs contrast, ~0-100; below = severely blurry",
          "minimum": 0,
          "title": "Min Sharpness",
          "type": "number"
        },
        "min_brightness": {
          "default": 60,
          "maximum": 255,
          "minimum": 0,
          "title": "Min Brightness",
          "type": "number"
        },
        "max_brightness": {
          "default": 235,
          "maximum": 255,
          "minimum": 0,
          "title": "Max Brightness",
          "type": "number"
        },
        "background": {
          "default": "plain, light, uncluttered",
          "description": "Style guide words",
          "title": "Background",
          "type": "string"
        },
        "style": {
          "default": "product centred, soft daylight, plain light background",
          "description": "How enhanced photos should look; used in regeneration prompts",
          "title": "Style",
          "type": "string"
        },
        "allow_ai_enhanced": {
          "default": true,
          "description": "May agents propose AI photos",
          "title": "Allow Ai Enhanced",
          "type": "boolean"
        },
        "classic_enhancement": {
          "default": true,
          "description": "Also offer her photo cleaned up in code (light, framing)",
          "title": "Classic Enhancement",
          "type": "boolean"
        },
        "ai_images_need_review": {
          "default": true,
          "description": "A listing using an AI photo goes to a person before publishing",
          "title": "Ai Images Need Review",
          "type": "boolean"
        },
        "candidates": {
          "default": 3,
          "description": "Regenerated photos to propose",
          "maximum": 4,
          "minimum": 1,
          "title": "Candidates",
          "type": "integer"
        },
        "looks": {
          "description": "One look per AI version, in order (repeating if fewer); none = `style` only",
          "items": {
            "$ref": "#/$defs/ImageLook"
          },
          "title": "Looks",
          "type": "array"
        },
        "aspect_ratio": {
          "default": "1:1",
          "description": "Shape of regenerated photos (catalogue tiles)",
          "enum": [
            "1:1",
            "4:5",
            "3:4",
            "4:3"
          ],
          "title": "Aspect Ratio",
          "type": "string"
        }
      },
      "title": "ImageStandards",
      "type": "object"
    },
    "QualityThresholds": {
      "additionalProperties": false,
      "properties": {
        "min_grade": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Min Grade"
        },
        "min_shelf_life_days": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Min Shelf Life Days"
        },
        "max_reject_fraction": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Reject Fraction"
        }
      },
      "title": "QualityThresholds",
      "type": "object"
    },
    "TermTemplate": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "payment_days": {
          "minimum": 0,
          "title": "Payment Days",
          "type": "integer"
        },
        "description": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Description",
          "type": "object"
        }
      },
      "required": [
        "id",
        "payment_days"
      ],
      "title": "TermTemplate",
      "type": "object"
    },
    "TextStandards": {
      "additionalProperties": false,
      "properties": {
        "title_max_chars": {
          "default": 70,
          "minimum": 10,
          "title": "Title Max Chars",
          "type": "integer"
        },
        "description_min_words": {
          "default": 25,
          "minimum": 0,
          "title": "Description Min Words",
          "type": "integer"
        },
        "bullets": {
          "default": 3,
          "maximum": 6,
          "minimum": 0,
          "title": "Bullets",
          "type": "integer"
        }
      },
      "title": "TextStandards",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "id": {
      "title": "Id",
      "type": "string"
    },
    "version": {
      "minimum": 1,
      "title": "Version",
      "type": "integer"
    },
    "retailer_type": {
      "title": "Retailer Type",
      "type": "string"
    },
    "ordering_mode": {
      "enum": [
        "auto_replenish",
        "manual",
        "standing_order"
      ],
      "title": "Ordering Mode",
      "type": "string"
    },
    "categories": {
      "items": {
        "$ref": "#/$defs/Category"
      },
      "title": "Categories",
      "type": "array"
    },
    "quality_thresholds": {
      "$ref": "#/$defs/QualityThresholds"
    },
    "term_templates": {
      "items": {
        "$ref": "#/$defs/TermTemplate"
      },
      "title": "Term Templates",
      "type": "array"
    },
    "specialists": {
      "description": "Agent ids to load",
      "items": {
        "type": "string"
      },
      "title": "Specialists",
      "type": "array"
    },
    "workflow_set": {
      "default": "default",
      "title": "Workflow Set",
      "type": "string"
    },
    "claims_requiring_proof": {
      "description": "Product claims flagged for review, e.g. organic",
      "items": {
        "type": "string"
      },
      "title": "Claims Requiring Proof",
      "type": "array"
    },
    "catalogue_standards": {
      "anyOf": [
        {
          "$ref": "#/$defs/CatalogueStandards"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Photo and text standards; none means no catalogue checks"
    }
  },
  "required": [
    "id",
    "version",
    "retailer_type",
    "ordering_mode"
  ],
  "title": "RetailerProfile",
  "type": "object"
}
