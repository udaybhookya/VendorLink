{
  "id": "/vendor",
  "name": "VendorLink",
  "short_name": "VendorLink",
  "description": "Sell to retailers in your own language, within rules you set.",
  "start_url": "/vendor",
  "scope": "/vendor",
  "display": "standalone",
  "background_color": "#f7f7f2",
  "theme_color": "#0f766e",
  "icons": [
    {
      "src": "/icons/vendor-192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "/icons/vendor-512.png",
      "sizes": "512x512",
      "type": "image/png"
    },
    {
      "src": "/icons/vendor-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/icons/vendor.svg",
      "sizes": "any",
      "type": "image/svg+xml"
    }
  ]
}
