{
  "agent_id": "slack",
  "name": "Slack channel",
  "kind": "channel",
  "tenant": "any",
  "description": "Posts questions and notices to Slack through the configured Slack MCP server, and reads thread replies.",
  "version": "0.1.0",
  "skills": [
    {
      "capability": "channel.slack.send",
      "input_schema": "ChannelMessage",
      "output_schema": "ChannelReceipt",
      "description": "Send one message"
    },
    {
      "capability": "channel.slack.poll",
      "input_schema": "PollRequest",
      "output_schema": "ChannelReplies",
      "description": "Read replies to a message"
    }
  ],
  "permissions": [
    "mcp"
  ],
  "transport": "local",
  "entrypoint": "agents.channels.slack.agent:SlackChannel"
}
